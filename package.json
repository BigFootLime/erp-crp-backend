    "test:run": "vitest run --config vitest.config.ts",
    "test:list": "vitest list --filesOnly --config vitest.config.ts",
    "test:collection": "node scripts/verify-vitest-collection.mjs",
    "test:ui": "vitest --ui --config vitest.config.ts"
