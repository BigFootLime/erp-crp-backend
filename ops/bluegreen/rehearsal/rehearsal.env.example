# Root-owned, mode 0600. Values below are placeholders only.
CERP_REHEARSAL_IMAGE=registry.example.invalid/cerp-backend@sha256:REPLACE_WITH_RELEASE_DIGEST
CERP_REHEARSAL_DIRECTORY_IMAGE=registry.example.invalid/cerp-backend@sha256:REPLACE_WITH_DIRECTORY_RELEASE_DIGEST
CERP_REHEARSAL_TRAEFIK_IMAGE=traefik@sha256:REPLACE_WITH_PROXY_DIGEST
CERP_REHEARSAL_DB_MARKER=0123456789abcdef0123456789abcdef
CERP_REHEARSAL_VAULT_MARKER=rehearsal-1710
CERP_REHEARSAL_VAULT_ROOT=/mnt/cerp-rehearsal-1710/vault
CERP_REHEARSAL_IMAGES_ROOT=/mnt/cerp-rehearsal-1710/images
DATABASE_URL=postgresql://clone_only_role:<clone-db-password>@127.0.0.1:5432/cerp_test_0123456789abcdef0123456789abcdef
CERP_REHEARSAL_DIRECTORY_DATABASE_URL=postgresql://directory_clone_role:<directory-clone-db-password>@127.0.0.1:5432/cerp_directory_0123456789abcdef0123456789abcdef
# Root-owned, group 1000 (image node account), mode 0640; never make this file world-readable.
CERP_REHEARSAL_DIRECTORY_CALLERS_FILE=/mnt/cerp-rehearsal-1710/directory/callers.json
CERP_REHEARSAL_DIRECTORY_STORAGE_ROOT=/mnt/cerp-rehearsal-1710/directory/storage
CERP_DIRECTORY_ENDPOINT=http://127.0.0.1:8085/internal/directory
CERP_SHARED_DIRECTORY_ENABLED=true
CERP_SHARED_DIRECTORY_SITE=cerp_test_0123456789abcdef0123456789abcdef
CERP_SHARED_DIRECTORY_ID=REPLACE_WITH_ISOLATED_DIRECTORY_ID
CERP_DIRECTORY_SITE_CALL_KEY=REPLACE_WITH_ISOLATED_SITE_KEY
CERP_GED_VAULT_ROOT=/app/data/documents/rehearsal-1710
CERP_GED_SENTINEL=/app/data/documents/rehearsal-1710/.cerp-sentinel
JWT_SECRET=REPLACE_WITH_CLONE_COMPATIBLE_SECRET
AUTH_RATE_LIMIT_HASH_KEY=REPLACE_WITH_CLONE_COMPATIBLE_SECRET
MFA_ROOT_KEY=REPLACE_WITH_CLONE_COMPATIBLE_32_BYTE_KEY
MFA_KEY_ID=REPLACE_WITH_CLONE_KEY_ID
CERP_IMAGES_ROOT=/app/uploads/images/rehearsal-1710
CERP_UPLOAD_SCAN_MODE=enforce
CERP_UPLOAD_SCANNER_COMMAND=clamdscan
CERP_UPLOAD_SCANNER_TIMEOUT_MS=120000
NODE_ENV=production
CERP_STANDBY=true
CERP_BACKGROUND_WORKERS=off
CERP_WEBHOOK_DELIVERY_ENABLED=0
EINVOICE_EREPORTING_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
RESEND_API_BASE_URL=
