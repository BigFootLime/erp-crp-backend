# Copy outside the repository as /etc/cerp/bluegreen/blue.env (root:root 0600).
# Do not put secret values in this file in source control.
PORT=18080
CERP_RELEASE_DIR=/srv/cerp/releases/RELEASE_ID
# The candidate starts as standby. Promotion changes only this line to false
# and restarts the promoted slot after the previous leader has stopped.
CERP_STANDBY=true
# Explicitly disable recurring jobs in the standby process.  This is required
# even though CERP_STANDBY also resolves to off in the runtime: it makes the
# intended safety boundary auditable from the effective service environment.
CERP_BACKGROUND_WORKERS=off
# The shared environment is loaded separately by the unit; do not duplicate or
# print its secrets here.
